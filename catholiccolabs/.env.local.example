# Find them in your Supabase dashboard: Project Settings → API.

# Project: Vineyard-dev (publishable values — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://kfrarmtbcaeulywpjdvw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zAEiE13Hp0LogWFtZAD0wQ_xTTRzCbG

# The canonical URL of this site (used for OAuth + password-reset redirects).
# In production set this to your real domain, e.g. https://catholiccolabs.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
