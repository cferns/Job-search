# Supabase project credentials — copy this file to `.env.local` and fill in.
# Find these in your Supabase dashboard: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The canonical URL of this site (used for OAuth + password-reset redirects).
# In production set this to your real domain, e.g. https://catholiccolabs.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
